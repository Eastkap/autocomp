# autocomp secrets — copy to .env (gitignored) and fill. Referenced by NAME only.
# Leave blank to keep the dependent action gated as a manual/approval step.
STRIPE_SECRET_KEY=
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
POSTHOG_API_KEY=
APIFY_TOKEN=
UPLOAD_POST_API_KEY=
RESEND_API_KEY=
WEBCLAW_API_KEY=
# Reddit access (create a free app at reddit.com/prefs/apps). See tools/web.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Phone push for approval gates via ntfy.sh (unguessable topic = capability URL).
# Subscribe the ntfy app to this exact string. See tools/notify.md.
NTFY_TOPIC=
# (No LOOP_TOKEN_BUDGET knob anymore — the hourly loop gates purely on the 5h window's
# reset clock, not a token %. See tools/loop.md.)
# Sync doc: the "autocomp — TO-DO" Google Doc used as the interim task inbox (you edit it,
# the loop reads it each tick). Non-secret. See tools/sync-doc.md.
SYNC_DOC_ID=1qiVCBraDXmpW2YH7HlLU6Wqs4jVF_fwbozZmpSMZZ4Y
# Shared autocomp Supabase project (data + auth + kanban; one project, a schema per venture).
# service_role/secret + the PAT are SECRET (loop-only). anon/publishable are public-safe (browser).
SUPABASE_URL=
SUPABASE_ANON_KEY=            # public-safe; used by the browser (kanban/config.js)
SUPABASE_SERVICE_KEY=        # service_role JWT — server-side only, bypasses RLS (tools/tasks.sh)
SUPABASE_PUBLISHABLE_KEY=    # optional, new-style public key (sb_publishable_…)
SUPABASE_SECRET_KEY=         # optional, new-style secret key (sb_secret_…)
# Management API — lets the loop run DDL / provision schemas per venture (tools/db.sh).
SUPABASE_ACCESS_TOKEN=       # Personal Access Token (sbp_…) — SECRET
SUPABASE_PROJECT_REF=        # project ref (the subdomain of SUPABASE_URL)
# Cloudflare (serverless deploys — see tools/deploy.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
