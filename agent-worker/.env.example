# agent-worker config — copy to .env on the homelab, fill in, then `docker compose up -d`.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...        # server-side; stays on the homelab
ANTHROPIC_API_KEY=sk-ant-...             # drives the agent loop — this burns tokens (your key/cost)

# Which identities THIS box is allowed to act as. Default bot-only.
# Add 'personal' ONLY if you've logged your personal profile in here and only want SAFE tasks.
IDENTITIES=boseclaw                       # or: boseclaw,personal

# Optional:
AGENT_MODEL=claude-sonnet-5              # cheaper for the agent loop; claude-opus-4-8 for hard tasks
WORKER_ID=homelab-agent
POLL_INTERVAL=8
PROFILES_DIR=./profiles                  # host dir holding boseclaw/ and personal/ Chrome profiles
