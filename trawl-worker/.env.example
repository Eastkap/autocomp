# trawl-worker config — copy to .env on the homelab, fill in, then `docker compose up -d`.
# These three come from the autocomp .env (ask the loop / copy them across):

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...        # server-side key — stays on the homelab, never in a browser

# Optional:
WORKER_ID=homelab                        # label shown on the jobs this box claims
BROWSER_POOL_SIZE=2                       # concurrent Camoufox browsers (raise if the box has RAM)
POLL_INTERVAL=5                          # seconds between empty-queue polls
